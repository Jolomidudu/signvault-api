# Backend port
PORT=4000

# Runtime environment
NODE_ENV=development

# Allowed frontend origin
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL connection string
# Supply the project-specific Neon connection URL locally; do not commit it.
DATABASE_URL=

# JWT configuration
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Neon Object Storage (use a private bucket and branch-scoped storage:read/write credentials)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEON_OBJECT_STORAGE_BUCKET=
